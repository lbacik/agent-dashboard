# Copy to .env and adjust for the test host. See README "Running in Docker
# (test deployments)". Defaults are safe: loopback-only publish address.
#
# Publish address for the dashboard port. Keep 127.0.0.1 unless this host is
# a trusted test machine; set the Pi's LAN IP (or 0.0.0.0) to expose the UI.
DASHBOARD_BIND=127.0.0.1
# Host port mapped to the container's 8000.
DASHBOARD_PORT=8000
# GID owning /var/run/docker.sock on the host that runs the daemon. Lets the
# non-root container user reach the socket via `group_add`. Compose reads
# this file on the machine you run it from, so with a remote Docker context
# take the GID from the daemon host, not your workstation. Check it through
# the same context:
#   docker run --rm -v /var/run/docker.sock:/var/run/docker.sock alpine stat -c %g /var/run/docker.sock
# A wrong value shows up as "permission denied ... docker.sock" in the UI.
DOCKER_GID=999
# Host header allow-list for LAN access: the Pi's hostname and/or LAN IP,
# comma-separated. `localhost` / `127.0.0.1` always stay allowed; `*` is
# never accepted.
AGENT_DASHBOARD_ALLOWED_HOSTS=raspberrypi,192.168.1.50
# Optional gateway tuning (empty = built-in defaults).
AGENT_DASHBOARD_POLL_INTERVAL=
AGENT_DASHBOARD_EXEC_TIMEOUT=
AGENT_DASHBOARD_MAX_CONCURRENT_EXECS=

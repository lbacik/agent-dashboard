# Copy to .env and adjust for the host. See README "Running in Docker".
# Defaults are safe: loopback-only publish address, LAN mode off.
#
# Publish address for the dashboard port. Keep 127.0.0.1 unless this host is
# on a trusted LAN; set the host's LAN IP (or 0.0.0.0) to expose the
# read-only view. Ignored with the LAN overlay, which publishes to 127.0.0.1
# only (the reverse proxy is the way in).
DASHBOARD_BIND=127.0.0.1
# Host port mapped to the container's 8000.
DASHBOARD_PORT=8000
# GID owning /var/run/docker.sock on the host that runs the daemon. Lets the
# non-root container user reach the socket via `group_add`. Compose reads
# this file on the machine you run it from, so with a remote Docker context
# take the GID from the daemon host, not your workstation. Check it through
# the same context:
#   docker run --rm -v /var/run/docker.sock:/var/run/docker.sock alpine stat -c %g /var/run/docker.sock
# A wrong value shows up as "permission denied ... docker.sock" in the UI.
DOCKER_GID=999
# Host header allow-list: the host names or addresses operators type in the
# browser, comma-separated. Without LAN mode: the host's name and/or LAN IP.
# In LAN mode: the name in VIRTUAL_HOST (required in LAN mode).
# `localhost` / `127.0.0.1` always stay allowed; `*` is never accepted.
AGENT_DASHBOARD_ALLOWED_HOSTS=raspberrypi,192.168.1.50
# Optional gateway tuning (empty = built-in defaults).
AGENT_DASHBOARD_POLL_INTERVAL=
AGENT_DASHBOARD_EXEC_TIMEOUT=
AGENT_DASHBOARD_MAX_CONCURRENT_EXECS=
# Control actions: `off` for a read-only dashboard (empty = on). Outside LAN
# mode the container's 0.0.0.0 bind keeps them unavailable anyway.
AGENT_DASHBOARD_CONTROL=
# Bound on one Control action's docker exec, in seconds (empty = 15; must
# stay above 10).
AGENT_DASHBOARD_CONTROL_EXEC_TIMEOUT=

# --- LAN mode (README "LAN mode") ------------------------------------------
# Every request needs a sign-in session. The LAN overlay below sets it to
# `on`; leave it empty otherwise.
AGENT_DASHBOARD_LAN_MODE=
# Reverse proxy addresses or CIDR blocks, comma-separated, whose
# X-Forwarded-For gives the client address for the sign-in delay. Usually
# the proxy network's subnet:
#   docker network inspect <network> --format '{{(index .IPAM.Config 0).Subnet}}'
AGENT_DASHBOARD_TRUSTED_PROXIES=
# Sign-in session limits in seconds (empty = 1800 idle, 43200 absolute).
# Idle at least 300; absolute between the idle limit and 604800 (7 days).
AGENT_DASHBOARD_SIGN_IN_IDLE_TIMEOUT=
AGENT_DASHBOARD_SIGN_IN_MAX_AGE=

# --- LAN overlay: the tested nginx-proxy + acme-companion example -----------
# Uncomment to run LAN mode behind the reverse proxy (ADR 0012). Compose
# 2.24+ is needed for the overlay. COMPOSE_FILE makes `up`, `exec` and
# `logs` use both files without -f.
#COMPOSE_FILE=docker-compose.yml:docker-compose.lan.yml
# The reverse proxy's Docker network (external; it must exist).
#PROXY_NETWORK=proxy
# The dashboard's host name, as operators type it; also put it in
# AGENT_DASHBOARD_ALLOWED_HOSTS.
#VIRTUAL_HOST=dashboard.example.lan
# Same name to have acme-companion issue a certificate; empty for none.
#LETSENCRYPT_HOST=
